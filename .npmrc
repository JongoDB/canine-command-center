# Metro (the React Native bundler used by Expo) walks node_modules expecting a
# flat, npm-style layout. pnpm's default symlinked isolation hides transitive
# deps from that walk, so Metro fails to resolve packages pulled in indirectly
# (e.g. @react-navigation/native via expo-router). node-linker=hoisted gives a
# flatter tree Metro is happy with — we trade a little disk + strict isolation
# for a working RN + pnpm monorepo. (Standard choice for this stack.)
node-linker=hoisted

# Don't fail installs on upstream peer-dep mismatches we don't control (common
# in the Expo/RN ecosystem). We still see the warnings.
strict-peer-dependencies=false
auto-install-peers=true
