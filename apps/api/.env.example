# @ccc/api — copy to apps/api/.env (git-ignored) for local dev. In CI/prod these
# come from the real environment. Validated by src/config/env.ts.

NODE_ENV=development
HOST=0.0.0.0
PORT=4000
LOG_LEVEL=info

# Postgres. Matches the docker-compose service (infra/docker-compose.yml); the
# POSTGRES_* values there default to ccc / ccc_dev_password / ccc.
DATABASE_URL=postgres://ccc:ccc_dev_password@localhost:5432/ccc

# Public origin of the API, the web client, and the browser origins allowed to
# call the API. WEB_BASE_URL is where verification / password-reset email links
# land (defaults to the first CORS origin if unset).
APP_BASE_URL=http://localhost:4000
WEB_BASE_URL=http://localhost:5173
CORS_ORIGINS=http://localhost:5173,http://localhost:4173

# Better Auth signing secret. Generate one, e.g.: openssl rand -base64 32
BETTER_AUTH_SECRET=replace-me-with-a-long-random-string

# Outbound email. Point at the mailpit container in dev (UI at http://localhost:8025).
# Leave MAIL_HOST unset to just log emails instead of sending.
MAIL_HOST=localhost
MAIL_PORT=1025
MAIL_SECURE=false
MAIL_FROM=Canine Command Center <no-reply@localhost>
# MAIL_USER=
# MAIL_PASSWORD=

# Claude access for "Scout" (wired into the chat proxy in M1.3). Prefer the
# OAuth token from `claude setup-token` (sent as `Authorization: Bearer ...`):
ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-xxxxxxxx
# ...or a billed API key instead (sent as `x-api-key: ...`). Set exactly one.
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx

# Media storage + per-user upload quota (all optional — defaults shown).
# UPLOADS_DIR=./uploads
# MEDIA_MAX_PER_USER=100
# MEDIA_MAX_BYTES_PER_USER=209715200   # 200 MiB
