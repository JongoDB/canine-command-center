{
  "name": "@ccc/api",
  "version": "0.0.0",
  "private": true,
  "type": "module",
  "description": "Canine Command Center — backend (Fastify + Postgres + Drizzle + Better Auth + Claude SSE proxy). The only component that holds secrets or talks to Claude.",
  "scripts": {
    "dev": "tsx watch --clear-screen=false src/index.ts",
    "build": "tsup",
    "start": "node dist/index.js",
    "typecheck": "tsc --noEmit",
    "test": "vitest run",
    "test:watch": "vitest",
    "db:generate": "drizzle-kit generate",
    "db:migrate": "tsx src/db/migrate.ts",
    "db:check": "tsx src/db/migrate.ts",
    "db:studio": "drizzle-kit studio",
    "ai:smoke": "tsx scripts/ai-smoke.ts",
    "db:up": "docker compose -f ../../infra/docker-compose.yml up -d postgres mailpit minio",
    "db:down": "docker compose -f ../../infra/docker-compose.yml down",
    "db:logs": "docker compose -f ../../infra/docker-compose.yml logs -f postgres"
  },
  "dependencies": {
    "@anthropic-ai/sdk": "^0.95.0",
    "@ccc/shared": "workspace:*",
    "@fastify/cors": "^10.0.2",
    "@fastify/helmet": "^13.0.1",
    "@fastify/multipart": "^9.0.3",
    "@fastify/sensible": "^6.0.3",
    "better-auth": "^1.6.0",
    "dotenv": "^16.4.7",
    "drizzle-orm": "^0.45.2",
    "fastify": "^5.2.1",
    "nodemailer": "^8.0.7",
    "pg": "^8.13.1",
    "pino-pretty": "^13.0.0",
    "zod": "^4.0.0",
    "sharp": "^0.34.4"
  },
  "devDependencies": {
    "@types/node": "^22.10.5",
    "@types/nodemailer": "^8.0.0",
    "@types/pg": "^8.11.10",
    "drizzle-kit": "^0.31.1",
    "tsup": "^8.3.5",
    "tsx": "^4.19.2",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
