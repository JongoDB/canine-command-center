{
  "name": "@ccc/mobile",
  "version": "0.0.0",
  "private": true,
  "description": "Canine Command Center — mobile client (Expo / React Native, iOS + Android). Shares domain logic with web via @ccc/shared and design tokens via @ccc/ui.",
  "main": "expo-router/entry",
  "scripts": {
    "dev": "expo start",
    "start": "expo start",
    "android": "expo run:android",
    "ios": "expo run:ios",
    "native:prebuild": "expo prebuild",
    "typecheck": "tsc --noEmit",
    "build": "tsc --noEmit",
    "test": "vitest run --passWithNoTests"
  },
  "dependencies": {
    "@babel/runtime": "^7.26.0",
    "@better-auth/expo": "^1.6.0",
    "@ccc/shared": "workspace:*",
    "@ccc/ui": "workspace:*",
    "better-auth": "^1.6.0",
    "expo": "~55.0.0",
    "expo-constants": "~55.0.0",
    "expo-image-picker": "~55.0.20",
    "expo-linking": "~55.0.0",
    "expo-network": "~55.0.0",
    "expo-router": "~55.0.0",
    "expo-secure-store": "~55.0.0",
    "expo-splash-screen": "~55.0.20",
    "expo-status-bar": "~55.0.0",
    "react": "^19.2.0",
    "react-native": "~0.83.6",
    "react-native-safe-area-context": "~5.8.0",
    "react-native-screens": "~4.23.0"
  },
  "devDependencies": {
    "@babel/core": "^7.26.0",
    "@types/react": "~19.2.0",
    "typescript": "^6.0.3",
    "vitest": "^2.1.8"
  }
}
