{
  "expo": {
    "name": "Canine Command Center",
    "slug": "canine-command-center",
    "scheme": "caninecommandcenter",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jongodb.caninecommandcenter"
    },
    "android": {
      "package": "com.jongodb.caninecommandcenter",
      "edgeToEdgeEnabled": true
    },
    "plugins": ["expo-router"],
    "experiments": {
      "typedRoutes": true
    }
  }
}
