{
  "expo": {
    "name": "Canine Command Center",
    "slug": "canine-command-center",
    "scheme": "caninecommandcenter",
    "version": "0.0.1",
    "orientation": "portrait",
    "userInterfaceStyle": "dark",
    "backgroundColor": "#0a0a0a",
    "icon": "./assets/icon.png",
    "newArchEnabled": true,
    "ios": {
      "supportsTablet": false,
      "bundleIdentifier": "com.jongodb.caninecommandcenter"
    },
    "android": {
      "package": "com.jongodb.caninecommandcenter",
      "edgeToEdgeEnabled": true,
      "adaptiveIcon": {
        "foregroundImage": "./assets/adaptive-icon.png",
        "backgroundColor": "#0a0a0a"
      }
    },
    "plugins": [
      "expo-router",
      [
        "expo-splash-screen",
        {
          "image": "./assets/splash-icon.png",
          "imageWidth": 200,
          "resizeMode": "contain",
          "backgroundColor": "#0a0a0a"
        }
      ],
      [
        "expo-image-picker",
        {
          "photosPermission": "Canine Command Center uses your photos so you can set a profile photo for your dog.",
          "cameraPermission": "Canine Command Center uses the camera so you can snap a profile photo for your dog."
        }
      ]
    ],
    "experiments": {
      "typedRoutes": true
    }
  }
}
