# Canine Command Center — root .env.example.
#
# Each app has its own .env (e.g. apps/api/.env — see apps/api/.env.example).
# This file documents the variables that affect Docker Compose / dev scripts at
# the repo root. Copy to `.env` (git-ignored) to override the defaults.

# Postgres dev container (infra/docker-compose.yml). The API's DATABASE_URL must
# line up with these — apps/api/.env.example defaults to matching values.
# (Data persists in named Docker volumes; see infra/docker-compose.yml.)
POSTGRES_USER=ccc
POSTGRES_PASSWORD=ccc_dev_password
POSTGRES_DB=ccc
POSTGRES_PORT=5432

# mailpit (dev SMTP catcher) — SMTP on 1025, web UI on 8025.
MAILPIT_SMTP_PORT=1025
MAILPIT_UI_PORT=8025

# minio (dev S3-compatible storage) — API on 9000, console on 9001.
MINIO_PORT=9000
MINIO_CONSOLE_PORT=9001
MINIO_ROOT_USER=ccc
MINIO_ROOT_PASSWORD=ccc_dev_password
