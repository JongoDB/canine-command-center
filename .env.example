# Canine Command Center — example env. Copy to `.env` (git-ignored) and fill in.
# This documents shared/root-level vars; in Phase 0 each app gets its own
# apps/<app>/.env.example with the rest.

# Claude access for the in-app assistant ("Scout").
# Prefer the OAuth token from `claude setup-token` (billed to your Claude
# subscription; the Anthropic SDK sends it as `Authorization: Bearer ...`):
ANTHROPIC_AUTH_TOKEN=sk-ant-oat01-xxxxxxxx
# ...or, alternatively, a billed API key (the SDK sends it as `x-api-key: ...`).
# Set exactly one of these; ANTHROPIC_AUTH_TOKEN wins if both are set.
# ANTHROPIC_API_KEY=sk-ant-api03-xxxxxxxx
